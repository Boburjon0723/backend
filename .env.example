# Copy to .env and fill in real values (never commit .env).
# PostgreSQL (Cloud SQL / Railway / local). SSL: remote uses rejectUnauthorized: false in code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server
PORT=4000
NODE_ENV=development

# Auth (production: use long random strings)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Used in auth.controller for token expiry (same names as in codebase)
NEXT_PUBLIC_JWT_EXPIRES_IN=1d
NEXT_PUBLIC_JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional — backend/src/config/redis.ts)
REDIS_URL=

# MongoDB (only some scripts: contacts migration, cleanup — optional)
MONGODB_URI=mongodb://localhost:27017/mali_platform

# LiveKit (video tokens + WebSocket URL)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Example cloud: wss://your-project.livekit.cloud
LIVEKIT_URL=wss://localhost:7880

# LiveKit → S3 recordings (optional; livekitRecording.service.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
LIVEKIT_RECORDINGS_BUCKET=
RECORDING_PUBLIC_BASE_URL=

# Firebase Admin JSON (single line) + bucket override (optional)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=

# Telegram / bot integration (auth.controller)
BOT_SERVICE_URL=
BOT_CONTROL_TOKEN=
BOT_LINK_TOKEN=

# Wallet / business rules
MENTOR_MONTHLY_MALI=100
SERVICE_COMMISSION_PERCENTAGE=0.05

# Video fallback
JITSI_DOMAIN=meet.jit.si
